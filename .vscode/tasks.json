{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Collaborator: build API test client",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Code/src/Collaborator.ApiClient/Collaborator.ApiClient.csproj",
        "--configuration",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Code"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Sample Product: build Taskboard",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/../collaborator-sample-app/Collaborator.SampleWebsite.csproj",
        "--configuration",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}/../collaborator-sample-app"
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
